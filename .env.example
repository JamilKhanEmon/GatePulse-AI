# GatePulse AI — Environment Configuration Template
# Copy this file to .env and configure your local settings

# Database settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gatepulse_db
DB_USER=root
DB_PASSWORD=

# Application server settings
PORT=5002
SECRET_KEY=generate_your_own_secret_key_here
FLASK_ENV=production

# Admin credentials (configured strictly here in .env)
ADMIN_EMAIL=admin@facility.local
ADMIN_PASSWORD=your_secure_password_here

# NVR credentials and host
NVR_HOST=
NVR_USER=
NVR_PASS=

# Camera sources and active channels
# CAM1_SOURCE=rtsp://user:pass@camera_ip:554/stream1
# CAM2_SOURCE=0 (0 = webcam, or rtsp:// url, or video file path)
# ACTIVE_CAMERAS=1,2 (comma separated camera numbers)
CAM1_SOURCE=0
CAM2_SOURCE=0
ACTIVE_CAMERAS=1

# AI Engine parameters
YOLO_MODEL=yolov8s.pt
YOLO_CONF_THRESHOLD=0.16
PLATE_COOLDOWN=60
STATIONARY_COOLDOWN=120
